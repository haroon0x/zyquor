{
  "name": "zyquor",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first X posting assistant.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "zyquor": "./scripts/zyquor.mjs"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "check": "pnpm build && pnpm -r check",
    "bootstrap": "node scripts/bootstrap.mjs",
    "smoke": "node --no-warnings scripts/smoke.mjs",
    "smoke:app": "pnpm build && node --no-warnings scripts/smoke-app.mjs",
    "smoke:http": "node --no-warnings scripts/smoke-http.mjs",
    "smoke:adapters": "pnpm --filter @zyquor/adapters build && node --no-warnings scripts/test-adapters.mjs",
    "smoke:generation": "pnpm --filter @zyquor/generation build && node scripts/smoke-generation.mjs",
    "spacing:check": "pnpm --filter @zyquor/core build && node scripts/verify-spacing.mjs",
    "harness:tweets": "pnpm --filter @zyquor/generation build && node scripts/tweet-harness.mjs",
    "profile:x": "node scripts/open-x-profile.mjs",
    "profile:x:check": "pnpm --filter @zyquor/browser build && node scripts/check-x-login.mjs",
    "profile:x:manual": "node scripts/open-x-profile-manual.mjs",
    "profile:x:cdp": "node scripts/open-x-profile-cdp.mjs",
    "profile:x:skywalker": "ZYQUOR_X_PROFILE_DIR=profiles/skywalker node scripts/open-x-profile-cdp.mjs",
    "x:mentions": "node scripts/poll-x-mentions.mjs",
    "x:demo-check": "node services/demo-checker/run-queue.mjs",
    "start": "node scripts/zyquor.mjs",
    "dev:api": "pnpm --filter @zyquor/api dev",
    "dev:web": "pnpm --filter @zyquor/web dev",
    "dev:worker": "pnpm --filter @zyquor/worker dev",
    "dev:desktop": "pnpm build && pnpm --filter @zyquor/desktop exec electron dist/main.js",
    "dist:desktop:dir": "pnpm build && pnpm --filter @zyquor/desktop dist:win:dir",
    "dist:desktop": "pnpm build && pnpm --filter @zyquor/desktop dist:win",
    "smoke:desktop": "pnpm build && node apps/desktop/scripts/logic-smoke.mjs",
    "dev:crawl4ai": "node scripts/crawl4ai-service.mjs",
    "test": "pnpm build && pnpm -r test"
  },
  "dependencies": {
    "@zyquor/core": "workspace:*",
    "@zyquor/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
