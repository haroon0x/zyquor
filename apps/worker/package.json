{
  "name": "@zyquor/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "pnpm build && ZYQUOR_RUN_WORKER=1 node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=threads --passWithNoTests"
  },
  "dependencies": {
    "@zyquor/core": "workspace:*"
  }
}
