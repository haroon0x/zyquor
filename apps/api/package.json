{
  "name": "@zyquor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "pnpm build && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
