  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@zyquor/accounts": "workspace:*",
    "@zyquor/adapters": "workspace:*",
    "@zyquor/automation": "workspace:*",
    "@zyquor/browser": "workspace:*",
    "@zyquor/core": "workspace:*",
    "@zyquor/generation": "workspace:*",
    "@zyquor/storage": "workspace:*",
    "fastify": "^5.1.0",
    "zod": "^3.24.1"
  }
}
