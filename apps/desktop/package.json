{
  "name": "@zyquor/desktop",
  "version": "0.0.0",
  "productName": "Zyquor",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm copy:web",
    "copy:web": "node scripts/copy-web.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && electron dist/main.js",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "pnpm build && node scripts/logic-smoke.mjs",
    "test": "vitest run --passWithNoTests",
    "prepack-zyq": "node ../../scripts/prepack-zyq.mjs",
    "prepack-zyq-undo": "node ../../scripts/prepack-zyq.mjs --undo",
    "dist:dir": "pnpm icons && pnpm prepack-zyq && pnpm copy:web && electron-builder --dir && pnpm prepack-zyq-undo",
    "dist:win": "pnpm icons && pnpm prepack-zyq && pnpm copy:web && electron-builder --win --x64 --publish onTagOrDraft && pnpm prepack-zyq-undo"
  },
  "dependencies": {
    "@zyquor/accounts": "workspace:*",
    "@zyquor/api": "workspace:*",
    "@zyquor/core": "workspace:*",
    "@zyquor/storage": "workspace:*",
    "@zyquor/worker": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.0",
    "typescript": "^5.7.2"
  }
}
