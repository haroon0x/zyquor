ZYQUOR_API_PORT=3000
ZYQUOR_API_URL=http://127.0.0.1:3000
ZYQUOR_WORKER_POLL_MS=5000
ZYQUOR_MAX_SAME_HOST_POSTS_PER_DAY=100
ZYQUOR_MAX_GITHUB_POSTS_PER_DAY=100
ZYQUOR_WORKER_AUTO_SEED_DEFAULT_INGEST=1

# Autopost spacing window (minutes). Picker adds ±15% jitter and an anti-cluster
# bias so consecutive gaps are not within 40% of each other. 30-90 by default.
ZYQUOR_POST_GAP_MIN_MINUTES=30
ZYQUOR_POST_GAP_MAX_MINUTES=90

# Per-day post cap with daily variance. Each calendar day picks a stable
# pseudo-random integer between MIN and MAX (inclusive), seeded by the date.
# Effective cap = min(account.dailyPostLimit, picked). Default 10-12 posts/day.
ZYQUOR_DAILY_POST_VARIANCE_MIN=10
ZYQUOR_DAILY_POST_VARIANCE_MAX=12

# Yolo autopost gate. score.quality comes from scoreTweetQuality (additive). The
# default of 3 rejects most slop, including all AI_SLOP_PHRASES hits and any
# candidate that scores negative overall.
ZYQUOR_QUALITY_MIN=3

# Draft generation provider: auto, openrouter, or ollama.
# auto priority: OpenRouter -> Ollama.
ZYQUOR_LLM_PROVIDER=auto

# OpenRouter is preferred for production-quality tweets.
ZYQUOR_OPENROUTER_API_KEY=
# Allowed free OpenRouter models:
# - nvidia/nemotron-3-super-120b-a12b:free
# - minimax/minimax-m2.5:free
# - tencent/hy3-preview:free
ZYQUOR_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ZYQUOR_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Enables Product Hunt launch ingestion.
ZYQUOR_PRODUCTHUNT_API_TOKEN=

# Ollama local API. Requires `ollama serve` and a pulled model.
ZYQUOR_OLLAMA_BASE_URL=http://127.0.0.1:11434
ZYQUOR_OLLAMA_MODEL=llama3.1

# Browser actions are disabled by default. Set prepare to 1 to open X compose and insert the draft text via CDP.
ZYQUOR_ENABLE_BROWSER_PREPARE=0

# Set to 1 only to enable the explicit final Post button click.
ZYQUOR_ENABLE_BROWSER_POST=0

# Browser prepare defaults to bundled Playwright Chromium. Use "chrome" only if
# Chrome is installed and you want that channel.
ZYQUOR_X_PROFILE_DIR=profiles/personal-main
ZYQUOR_BROWSER_CHANNEL=chromium
ZYQUOR_BROWSER_CDP_URL=
ZYQUOR_BROWSER_CDP_PORT=9222
ZYQUOR_BROWSER_ACTION_DELAY_MS=1800
ZYQUOR_BROWSER_TYPING_DELAY_MS=20
ZYQUOR_BROWSER_CLOSE_AFTER_PREPARE=1

# Close the entire Chrome browser after each post to free system resources.
# The worker auto-relaunches Chrome CDP before the next post.
ZYQUOR_BROWSER_CLOSE_AFTER_POST=1
