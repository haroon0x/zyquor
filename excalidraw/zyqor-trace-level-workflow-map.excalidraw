      "seed": 1897489515,
      "version": 1,
      "versionNonce": 972336289,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "Source adapters currently wired by default: aggregated news and RSS. The aggregated news adapter fans out to Hacker News, Reddit, TechCrunch, arXiv, GitHub, GDELT, company RSS, hiring, and optional Product Hunt.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Source adapters currently wired by default: aggregated news and RSS. The aggregated news adapter fans out to Hacker News, Reddit, TechCrunch, arXiv, GitHub, GDELT, company RSS, hiring, and optional Product Hunt.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "text_28ba373f1586",
      "type": "text",
      "x": 100,
      "y": 2630,
      "width": 3000,
      "height": 26.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1465658706,
      "version": 1,
      "versionNonce": 1494394159,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "Daily posting uses the account limit plus deterministic variance and a hard cap. The current local configuration targets about 3–4 posts/day and enforces spacing.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Daily posting uses the account limit plus deterministic variance and a hard cap. The current local configuration targets about 3–4 posts/day and enforces spacing.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "text_29524b1f5e1a",
      "type": "text",
      "x": 100,
      "y": 3150,
      "width": 4200,
      "height": 26.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 260911067,
      "version": 1,
      "versionNonce": 2143849588,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "These records are stored locally in SQLite, with a JSON fallback when SQLite cannot be used. Browser screenshots, traces, media, profiles, and logs stay on the local machine.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "These records are stored locally in SQLite, with a JSON fallback when SQLite cannot be used. Browser screenshots, traces, media, profiles, and logs stay on the local machine.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "text_415b181af790",
      "type": "text",
      "x": 100,
      "y": 3710,
      "width": 4300,
      "height": 26.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 2134289237,
      "version": 1,
      "versionNonce": 783249674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "Runtime processes: web UI → API → worker → browser. Desktop can run API and worker in-process. CLI can call the same local system.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Runtime processes: web UI → API → worker → browser. Desktop can run API and worker in-process. CLI can call the same local system.",
      "autoResize": false,
      "lineHeight": 1.25
    }
  ],
